"                                                                                "
"  ╭ Aide ────────────────────────────────────────────────────────────────────╮  "
"  │ Commandes (tapez / ou Ctrl+P)                                            │  "
"  │  /new                       Nouvelle conversation  (Ctrl+N)              │  "
"  │  /history                   Liste des conversations  (Ctrl+L)            │  "
"  │  /model [nom]               Choisir le modèle (ou le nommer directement) │  "
"  │                             (F2)                                         │  "
"  │  /context                   Taille du contexte et détail                 │  "
"  │  /prompt                    Voir exactement ce qui part au modèle        │  "
"  │  /add <fichier>             Joindre un fichier texte au contexte (Tab    │  "
"  │                             complète le chemin)                          │  "
"  │  /clear                     Vider le contexte (l'historique reste        │  "
"  │                             affiché)                                     │  "
"  │  /compact                   Résumer l'historique pour libérer le contexte│  "
"  │  /index <dossier> [nom]     Indexer un dossier (--types pdf,md pour      │  "
"  │                             filtrer)                                     │  "
"  │  /collections               Collections de documents indexées            │  "
"  │  /rag <collection>[,…]|off  Répondre à partir d'une collection de        │  "
"  │                             documents                                    │  "
"  │  /forget <collection>       Supprimer une collection (pas vos fichiers)  │  "
"  │  /rename <titre>            Renommer la conversation (Ctrl+R dans la     │  "
"  │                             liste)                                       │  "
